{
  "name": "duckd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Socratic debugging companion that guides you to the bug instead of handing you the fix.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanishJr/duckd.git"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && tsc -b && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
