{
  "name": "@duckd/hooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Code PreToolUse / Stop guard scripts that keep the host agent from leaking the fix.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
