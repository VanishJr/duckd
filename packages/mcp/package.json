{
  "name": "@duckd/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server over @duckd/core — stdio and streamable HTTP transports.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "duckd-mcp": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@duckd/code-context": "workspace:*",
    "@duckd/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
